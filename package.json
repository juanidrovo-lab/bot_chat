{
  "name": "providencia-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env src/adapters/http/servidor.ts",
    "db:generate": "drizzle-kit generate",
    "db:aprovisionar": "node --env-file-if-exists=.env scripts/aprovisionar.ts",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrar.ts",
    "panel:invitar": "node --env-file-if-exists=.env scripts/invitar.ts",
    "audios:registrar": "node --env-file-if-exists=.env scripts/audios.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "node scripts/con-postgres.mjs vitest run --config vitest.integracion.config.ts",
    "lint": "eslint .",
    "lint:arch": "eslint . --config eslint.arquitectura.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.125.0",
    "@googleapis/calendar": "20.0.0",
    "@sentry/node": "10.74.0",
    "@simplewebauthn/server": "13.3.3",
    "drizzle-orm": "0.45.2",
    "google-auth-library": "11.0.2",
    "hono": "4.13.8",
    "pg": "8.16.3",
    "pg-boss": "12.32.0",
    "pino": "9.13.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.1",
    "eslint-plugin-boundaries": "5.0.2",
    "globals": "^17.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vitest": "3.2.7"
  }
}
